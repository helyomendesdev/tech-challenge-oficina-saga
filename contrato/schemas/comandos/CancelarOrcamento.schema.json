{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://oficina-saga.fiap/contrato/schemas/comandos/CancelarOrcamento.schema.json",
  "title": "CancelarOrcamento",
  "description": "OS Service -> Billing: compensacao; invalida o orcamento (e estorna, se houver pagamento).",
  "allOf": [
    {
      "$ref": "../envelope.schema.json"
    }
  ],
  "properties": {
    "type": {
      "const": "CancelarOrcamento"
    },
    "version": {
      "const": 1
    },
    "causationId": {
      "$ref": "../comum.schema.json#/definitions/uuid"
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "orcamentoId",
        "motivo"
      ],
      "properties": {
        "orcamentoId": {
          "$ref": "../comum.schema.json#/definitions/uuid"
        },
        "motivo": {
          "$ref": "../comum.schema.json#/definitions/motivoCancelamento"
        }
      }
    }
  }
}
